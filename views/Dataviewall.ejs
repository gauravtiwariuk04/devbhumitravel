<!DOCTYPE html>
<html lang="en">
<head>
    <title>User Profile</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #dddddd;
            text-align: left;
            padding: 8px;
        }
        th {
            background-color: #f2f2f2;
        }
        img {
            max-width: 50px;
            height: auto;
        }
    </style>
</head>
<body>
    <h1>All Users</h1>
    
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Gender</th>
                <th>State</th>
                <th>Profile Image</th>
                <th colspan="2">Action</th>
            </tr>
        </thead>
        <tbody>
            <% usersList.forEach(user => { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.address %></td>
                    <td><%= user.phone %></td>
                    <td><%= user.gender %></td>
                    <td><%= user.state %></td>
                    <td><img src="/uploads/<%= user.profile_image %>" width="250" height="200"></td>
                    <td><a href="/edit/<%= user.id %>">Edit</a></td>
                    <td><a href="/Delete/<%= user.id %>">Delete</a></td>
                   
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
